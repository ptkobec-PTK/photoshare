GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ชื่อโฟลเดอร์หลักใน Drive
ROOT_FOLDER_NAME=PhotoShare
# owner = ลบได้เฉพาะเจ้าของอัลบั้ม/ผู้อัปโหลดรูปนั้น (เบราว์เซอร์เดียวกัน) | public = ใครก็ลบได้ทุกอย่าง
DELETE_MODE=owner
# รหัสแอดมิน ลบได้ทุกอย่าง (ปล่อยว่าง = ปิด)
ADMIN_PASSWORD=
PORT=3000
CACHE_DIR=./cache
